{
  "compilerOptions": {
    "target": "ES2020", "module": "CommonJS", "moduleResolution": "Node",
    "lib": ["ES2020", "DOM", "DOM.Iterable"], "types": [],
    "strict": true, "noImplicitReturns": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "rootDir": "src", "outDir": ".test-build"
  },
  "include": ["src/**/*.ts"]
}
